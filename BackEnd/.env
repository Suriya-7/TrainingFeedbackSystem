PORT=5000
JWT_SECRET=TrainingFeedbackSystem@2026

# --- Oracle (from your DB team) ---
ORACLE_USER=TFMS
ORACLE_PASSWORD=TFMS123
ORACLE_HOST=192.52.52.37
ORACLE_PORT=1521
# They gave you a SID, so use ORACLE_SID. (If they ever say it is a
# "service name" instead, delete the SID line and use ORACLE_SERVICE_NAME.)
ORACLE_SID=TSTFORAK
# ORACLE_SERVICE_NAME=
DB_CONNECT_STRING = (DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=${ORACLE_HOST})(PORT=${ORACLE_PORT}))(CONNECT_DATA=(SID=${ORACLE_SID})))
# Only if the DB is Oracle 11g (error NJS-138 on connect): install Oracle
# Instant Client and put its folder here, e.g. C:\oracle\instantclient_19_23
# ORACLE_CLIENT_LIB_DIR=

# --- External employee REST API (from your DB person) ---
# Replace in services/employeeApiService.js once you know the real shape —
# this is only the base URL / key, not the logic.
EMPLOYEE_API_BASE_URL=https://their-domain.example.com/api
EMPLOYEE_API_KEY=the_key_they_give_you

# --- This plant, for now ---
PLANT_CODE=PLANT1

# --- Admin login (single plant for now) ---
ADMIN_USERNAME=dietech
ADMIN_PASSWORD=dietechadmin07

# --- PDF generation on Windows/Mac (optional) ---
# The bundled Chromium only runs on Linux. For local testing on Windows,
# point this at your installed Chrome. Leave unset on Render/Linux.
# CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_12_2

USE_MOCK_EMPLOYEE_API=true