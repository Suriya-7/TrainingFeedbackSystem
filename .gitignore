```gitignore
# ==============================
# Logs
# ==============================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================
# Dependencies
# ==============================
node_modules/

# ==============================
# Build outputs
# ==============================
dist/
dist-ssr/
build/
coverage/

# ==============================
# Environment variables and secrets
# ==============================
.env
.env.*
!.env.example

# ==============================
# Local configuration
# ==============================
*.local

# ==============================
# Editor directories and files
# ==============================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==============================
# Temporary files
# ==============================
tmp/
temp/
*.tmp
*.bak

# ==============================
# Uploaded files and generated data
# ==============================
uploads/*
!uploads/.gitkeep

# ==============================
# Oracle / database local files
# ==============================
*.dmp
*.dbf
*.trc
*.log.*

# ==============================
# OS-generated files
# ==============================
Thumbs.db
Desktop.ini
$RECYCLE.BIN/